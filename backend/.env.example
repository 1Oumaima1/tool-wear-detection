# --- App ---
ENV=development
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agatronic_monitoring

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI Model ---
MODEL_PATH=models/final_model.keras
IMG_SIZE=224
USE_TTA=true
TTA_ROUNDS=5

# --- Video monitoring ---
VIDEO_FOLDER=videos
DEFAULT_FRAME_INTERVAL_SECONDS=2.0

# --- Decision engine defaults ---
DEFAULT_CONFIDENCE_THRESHOLD=0.75
DEFAULT_CONSECUTIVE_DETECTIONS=3

# --- SMTP (email alerts) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=alerts@agatronic.com
ALERT_EMAIL_TO=maintenance@agatronic.com

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
