# --- Copie ce fichier en .env à la racine avant de lancer docker compose ---

# --- PostgreSQL ---
POSTGRES_USER=agatronic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agatronic_monitoring
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- Decision Engine ---
DEFAULT_FRAME_INTERVAL_SECONDS=2.0
DEFAULT_CONFIDENCE_THRESHOLD=0.75
DEFAULT_CONSECUTIVE_DETECTIONS=3

# --- SMTP (alertes email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_FROM=alerts@agatronic.com
ALERT_EMAIL_TO=maintenance@agatronic.com

# --- Frontend ---
FRONTEND_PORT=3000
